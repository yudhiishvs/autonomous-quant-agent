# Alpaca paper-execution credentials. Never put live-account credentials here.
APA_ALPACA_PAPER_API_KEY=
APA_ALPACA_PAPER_SECRET_KEY=

# Keep NO for doctor, backtest, replay, observer, dashboard, and dry-run use.
# Change only when intentionally enabling simulated Alpaca paper orders and only
# after configs/paper.yaml sets execution.paper_order_submission_enabled: true.
APA_ENABLE_PAPER_ORDERS=NO

# Dedicated market-data collector credentials. These are mounted only into the
# collector and are never used by trading, research, dashboard, or CI processes.
APA_ALPACA_DATA_API_KEY=
APA_ALPACA_DATA_SECRET_KEY=

# Least-privilege runtime PostgreSQL URL. Keep the database private and fully verify TLS.
# Example shape: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
APA_MARKET_DATA_DATABASE_URL=

# Schema-owner PostgreSQL URL used only for explicit migration commands. Never
# expose this credential to the continuously running collector container.
APA_MARKET_DATA_MIGRATION_DATABASE_URL=

# Required only when the hosted database has no historical coverage checkpoint.
# Use an ISO-8601 date or UTC timestamp, for example 2025-01-01.
APA_MARKET_DATA_HISTORY_START=
