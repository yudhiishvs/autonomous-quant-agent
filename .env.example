# Alpaca PAPER-account credentials only. Never put live-account credentials here.
APA_ALPACA_PAPER_API_KEY=
APA_ALPACA_PAPER_SECRET_KEY=

# Keep NO for doctor, backtest, replay, observer, dashboard, and dry-run use.
# Change only when intentionally enabling simulated Alpaca paper orders and only
# after configs/paper.yaml sets execution.paper_order_submission_enabled: true.
APA_ENABLE_PAPER_ORDERS=NO
