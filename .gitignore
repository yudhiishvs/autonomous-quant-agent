# Unreviewed hidden files and tool-state directories are local by default.
.*
!/.dockerignore
!/.editorconfig
!/.gitignore
!/.python-version
!/.github/
!/.github/**
!/.agents/
/.agents/*
!/.agents/skills/
!/.agents/skills/**
!/.vscode/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json

# Public deterministic fixtures are the only default-trackable data subtree.
data/*
!data/fixtures/
!data/fixtures/**

# Re-exclude hidden state and caches beneath reviewed recursive subtrees.
/.github/**/.*
/.agents/skills/**/.*
data/fixtures/**/.*
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.venv/

# Operating-system, editor, and temporary state.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.tmp
*.partial
*.orig
*~

# Credentials and local environment overrides must never be committed.
.env
.env.*
.local/
*.pem
*.key
*.p12
*.pfx
*.secret
*.token
credentials/
.credentials/
local_credentials/
secrets/
credentials.json
local_credentials.json
generated_secrets.json
*.log
*.pid
*.db
*.sqlite
*.sqlite3
*.bak
*.backup

# Downloaded data, generated evidence, and mutable operational state are local artifacts.
audit/
runtime/
outputs/
scratch/
tmp/
transcripts/

# The reviewed placeholder is the only environment-file exception.
!/.env.example
