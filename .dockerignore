# Default-deny the build context. Every included path is consumed by a current
# image or is an explicitly reviewable public fixture/configuration artifact.
**
!.dockerignore
!Dockerfile
!README.md
!alembic.ini
!app.py
!pyproject.toml
!uv.lock
!configs/
!configs/**
!data/
!data/fixtures/
!data/fixtures/**
!docs/
!docs/**
!migrations/
!migrations/**
!scripts/
!scripts/**
!src/
!src/**

# Re-exclude sensitive or generated material even beneath an included tree.
**/.env*
**/.local
**/.local/**
**/.venv
**/.venv/**
**/.idea
**/.idea/**
**/.vscode
**/.vscode/**
**/.git
**/.git/**
**/.agents
**/.agents/**
**/.*
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/*.egg-info
**/*.egg-info/**
**/.pytest_cache
**/.pytest_cache/**
**/.ruff_cache
**/.ruff_cache/**
**/.mypy_cache
**/.mypy_cache/**
**/.coverage
**/coverage.xml
**/htmlcov
**/htmlcov/**
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.secret
**/*.token
**/credentials
**/credentials/**
**/.credentials
**/.credentials/**
**/local_credentials
**/local_credentials/**
**/secrets
**/secrets/**
**/credentials.json
**/local_credentials.json
**/generated_secrets.json
**/audit
**/audit/**
**/runtime
**/runtime/**
**/outputs
**/outputs/**
**/scratch
**/scratch/**
**/tmp
**/tmp/**
**/transcripts
**/transcripts/**
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log
**/*.pid
**/*.bak
**/*.backup
**/*.tmp
**/*.partial
**/*.orig
**/*.swp
**/*~

# The reviewed placeholder is the only environment-file exception.
!/.env.example
